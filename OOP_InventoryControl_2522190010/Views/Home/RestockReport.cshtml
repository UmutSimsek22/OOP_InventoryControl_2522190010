@model List<OOP_InventoryControl_2522190010.Models.InventoryItem>
@{ ViewData["Title"] = "Sipariş Raporu"; }

<div class="container mt-4">
    <div class="alert alert-warning border-warning shadow-sm">
        <h2 class="alert-heading">⚠️ Kritik Stok & Sipariş Önerileri</h2>
        <p>Aşağıdaki teknolojik ürünlerin stoğu kritik seviyenin (10 adet) altına düşmüştür.</p>
    </div>

    <table class="table table-striped mt-3 shadow-sm">
        <thead class="table-light">
        <tr>
            <th>Ürün Adı</th>
            <th>Kategori</th>
            <th>Mevcut Stok</th>
            <th>Tedarikçi Bilgisi</th>
            <th>Sipariş Önerisi</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            // Basit Algoritma: Stoğu 20 adede tamamlayacak kadar sipariş ver.
            int needed = 20 - item.Quantity;
                
            <tr>
                <td class="fw-bold">@item.ProductDetails.Name</td>
                <td>@item.ProductDetails.Category</td>
                <td class="text-danger fw-bold fs-5">@item.Quantity</td>
                <td>
                    <strong>@item.SupplierDetails.CompanyName</strong><br/>
                    <small>@item.SupplierDetails.Email</small>
                </td>
                <td>
                    <span class="badge bg-danger p-2 fs-6">
                        + @needed Adet Sipariş Ver
                    </span>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="mt-4">
        <a href="/Home/Index" class="btn btn-secondary">← Depoya Dön</a>
    </div>
</div>